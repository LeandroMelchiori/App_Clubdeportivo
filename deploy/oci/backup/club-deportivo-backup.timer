[Unit]
Description=Backup diario de la base de Club deportivo

[Timer]
# 06:15 UTC (03:15 en Argentina), con hasta 15 minutos de demora al azar.
OnCalendar=*-*-* 06:15:00 UTC
RandomizedDelaySec=15min
# Si la VM estaba apagada a esa hora, corre al arrancar.
Persistent=true

[Install]
WantedBy=timers.target
